# Core Architecture
core:
  frontend:
    framework: "next.js"
    typescript: true
    components:
      ui_libraries:
        - tailwindcss
        - headlessui
        - radix_ui
        - framer_motion
      styling:
        tailwind: true
        css_modules: true
    state_management:
      react_hooks: true
      context_api: true
  
  backend:
    runtime: "node.js"
    database: "mongodb"
    real_time:
      socket_io: true
      websocket: true
    ai_integration:
      anthropic_claude: true
      custom_models: true

# File Structure
file_structure:
  source:
    components:
      path: "src/components/"
      subfolders:
        ui: "src/components/ui/"
        chat: "src/components/chat/"
        analysis: "src/components/analysis/"
        customization: "src/components/customization/"
        deployment: "src/components/deployment/"
    
    lib:
      path: "src/lib/"
      subfolders:
        ai: "src/lib/ai/"
        db: "src/lib/db/"
        github: "src/lib/github/"
        chat: "src/lib/chat/"
        utils: "src/lib/utils/"
    
    pages:
      path: "src/app/"
      subfolders:
        api: "src/app/api/"
        auth: "src/app/auth/"
        dashboard: "src/app/dashboard/"
        projects: "src/app/projects/"
        settings: "src/app/settings/"

