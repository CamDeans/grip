# MongoDB (projects, users, chat, and state are stored here)
# To see the same projects on local (npm run dev) as on the deployed app (Vercel),
# use the SAME MONGODB_URI in .env.local as in Vercel → Project Settings → Environment Variables.
# If local uses a different URI, you get a different database and won't see projects created on Vercel.
# Optional: if Vercel uses MONGODB_DB_NAME, set the same value here so auth and projects use the same DB.
# After changing .env.local: stop npm run dev, start it again (env is read at startup). Sign out and sign in on local so your session matches the user in the shared DB.
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/test?retryWrites=true&w=majority"
# MONGODB_DB_NAME=test

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# OAuth Providers
GITHUB_ID="your-github-id"
GITHUB_SECRET="your-github-secret"
GOOGLE_ID="your-google-id"
GOOGLE_SECRET="your-google-secret"

# Anthropic (required for G.R.I.P. AI chat, enhanced chat, planning, code gen)
ANTHROPIC_API_KEY="your-anthropic-api-key"
# Optional: override default models (leave unset to use app defaults)
# ANTHROPIC_MODEL_CHAT="claude-3-sonnet-20240229"
# ANTHROPIC_MODEL_OPUS="claude-3-opus-20240229"
# ANTHROPIC_MODEL_FAST="claude-3-haiku-20240307"

# Github API
GITHUB_API_TOKEN="your-github-api-token"

# Analysis run (optional but recommended for Vercel): secret for internal analysis/run endpoint.
# Set to a random string (e.g. openssl rand -hex 16). Required in production so analysis/refresh can trigger long-running analysis without 504.
# ANALYSIS_INTERNAL_SECRET="your-random-secret"

# Vercel (required for Deploy to Vercel)
VERCEL_TOKEN="your-vercel-token"
VERCEL_TEAM_ID=""

# Stripe (subscriptions + one-time token add-ons)
STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Subscription tier price IDs (create in Stripe Dashboard → Products → Prices, recurring)
STRIPE_PRICE_ID_STARTER="price_..."
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_PRICE_ID_TEAM="price_..."

# One-time token add-on price IDs (create in Stripe → Products → one-time payment, e.g. $6.99 and $13.99)
STRIPE_PRICE_ID_ADD_TOKENS_500K="price_..."
STRIPE_PRICE_ID_ADD_TOKENS_1M="price_..."

# Feature Flags
ENABLE_ENHANCED_CHAT=true
ENABLE_PROJECT_AUTOMATION=true
ENABLE_REPOSITORY_SYNC=true 